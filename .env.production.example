# Production environment example for Hami Card V2
# Copy this file to .env on the server and replace placeholders with real values.
# Never commit real secrets.

NODE_ENV=production

# SQLite database URL used by Prisma.
# Example shape only; set the real server path in .env.
DATABASE_URL="file:/absolute/path/to/hami-card-v2.db"

# JWT_SECRET must be a strong random value with at least 32 characters.
# Generate on the server, for example: openssl rand -base64 32
JWT_SECRET=replace_with_secure_random_32_plus_character_value

# TOKEN_PEPPER must be a separate strong random value with at least 32 characters.
# Generate on the server, for example: openssl rand -base64 32
TOKEN_PEPPER=replace_with_different_secure_random_32_plus_character_value

# Demo/staging only fixed OTP fallback while SMS provider access is unavailable.
# Keep disabled for real production with real users.
DEMO_FIXED_OTP_ENABLED=false
DEMO_FIXED_OTP=

# Commission percentage for online plan referral purchases.
# Required for referral commissions; leave unset to skip commission creation safely.
ONLINE_PLAN_COMMISSION_PERCENT=

# Public application URL used by clients and deployment references.
NEXT_PUBLIC_APP_URL=https://example.com

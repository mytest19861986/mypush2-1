generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ============================================
// Users & Authentication
// ============================================

model User {
  id                     String    @id @default(cuid())
  mobile                 String    @unique
  email                  String?   @unique
  passwordHash           String?
  status                 String    @default("ACTIVE") // ACTIVE, INACTIVE, BLOCKED
  isMobileVerified       Boolean   @default(false)
  isPasswordLoginEnabled Boolean   @default(false)
  mustChangePassword     Boolean   @default(false)
  passwordChangedAt      DateTime?
  failedLoginAttempts    Int       @default(0)
  lockedUntil            DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
  deletedAt              DateTime?

  // Relations
  profile            UserProfile?
  roles              UserRole[]
  agent              Agent?
  doctor             Doctor?
  uploads            Upload[]
  refreshTokens      RefreshToken[]
  devices            UserDevice[]
  loginLogs          LoginLog[]
  auditLogs          AuditLog[]
  agentReviews       AgentDocument[]     @relation("DocumentReviewer")
  userPlans          UserPlan[]
  referredBy         UserPlan[]          @relation("Referrer")
  contracts          Contract[]
  commissions        Commission[]
  transactions       Transaction[]
  planHolders        PlanHolder[]
  payments           Payment[]
  visits             Visit[]
  reviews            Review[]
  wallet             Wallet?
  walletTransactions WalletTransaction[]
  settlements        Settlement[]
  salesCustomers     SalesCustomer[]     @relation("SalesCustomerSalesPartner")

  @@index([mobile])
  @@index([status])
}

model UserProfile {
  id                     String    @id @default(cuid())
  userId                 String    @unique
  firstName              String?   @default("")
  lastName               String?   @default("")
  nationalCode           String?   @unique
  avatar                 String?
  birthDate              DateTime?
  gender                 String? // MALE, FEMALE
  address                String?
  payoutCardNumber       String?
  payoutSheba            String?
  payoutAccountOwnerName String?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ============================================
// Roles & Permissions (RBAC)
// ============================================

model Role {
  id          String   @id @default(cuid())
  name        String   @unique // SUPER_ADMIN, ADMIN, SUPPORT, AGENT, USER, DOCTOR
  title       String // عنوان فارسی
  description String?  @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  userRoles       UserRole[]
  rolePermissions RolePermission[]
}

model Permission {
  id        String   @id @default(cuid())
  name      String   @unique // manage_users, view_reports, etc.
  module    String // users, agents, doctors, reports, plans, contracts
  title     String? // عنوان فارسی
  createdAt DateTime @default(now())

  rolePermissions RolePermission[]
}

model UserRole {
  id         String   @id @default(cuid())
  userId     String
  roleId     String
  assignedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
}

model RolePermission {
  id           String   @id @default(cuid())
  roleId       String
  permissionId String
  createdAt    DateTime @default(now())

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
}

// ============================================
// Doctors (پزشکان)
// ============================================

model Doctor {
  id              String    @id @default(cuid())
  userId          String    @unique
  medicalCode     String?   @unique // کد نظام پزشکی
  specialty       String? // تخصص
  clinicName      String? // نام مطب
  clinicAddress   String? // آدرس مطب
  city            String? // شهر
  province        String? // استان
  phone           String? // تلفن مطب
  bio             String? // بیوگرافی
  discountPercent Int       @default(0) // درصد تخفیف ویزیت (توسط مدیر — ۰ = استفاده از طرح بیمار)
  status          String    @default("PENDING") // PENDING, APPROVED, REJECTED, SUSPENDED
  verifiedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  contracts Contract[]
  visits    Visit[]
  reviews   Review[]

  @@index([status])
  @@index([specialty])
}

// ============================================
// Discount Plans (طرح‌های تخفیف)
// ============================================

model DiscountPlan {
  id                            String   @id @default(cuid())
  name                          String // نام طرح
  description                   String? // توضیحات
  price                         Int      @default(0) // قیمت (تومان)
  discountPercent               Int      @default(0) // درصد تخفیف
  durationDays                  Int      @default(30) // مدت طرح (روز)
  maxUses                       Int      @default(-1) // حداکثر دفعات استفاده (-1 = نامحدود)
  salesPartnerCommissionPercent Int      @default(0)
  referralCommissionPercent     Int      @default(0)
  status                        String   @default("ACTIVE") // ACTIVE, INACTIVE
  features                      String? // ویژگی‌های طرح (JSON array)
  createdAt                     DateTime @default(now())
  updatedAt                     DateTime @updatedAt

  userPlans      UserPlan[]
  payments       Payment[]
  salesCustomers SalesCustomer[]

  @@index([status])
}

// ============================================
// User Plans (طرح‌های خریداری شده توسط کاربران)
// ============================================

model PlanHolder {
  id           String    @id @default(cuid())
  userId       String?
  firstName    String?   @default("")
  lastName     String?   @default("")
  nationalCode String    @unique
  mobile       String?
  birthDate    DateTime?
  gender       String?
  status       String    @default("ACTIVE") // ACTIVE, INACTIVE
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user      User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  userPlans UserPlan[]
  visits    Visit[]
  payments  Payment[]

  @@index([userId])
  @@index([mobile])
  @@index([status])
}

model Payment {
  id             String    @id @default(cuid())
  userId         String?
  planHolderId   String?
  planId         String?
  amount         Int       @default(0)
  discountAmount Int       @default(0)
  finalAmount    Int       @default(0)
  status         String    @default("PENDING") // PENDING, SUCCESS, FAILED, CANCELLED
  gateway        String?
  authority      String?
  refId          String?
  trackingCode   String?
  paidAt         DateTime?
  failedAt       DateTime?
  metadata       String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user       User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  planHolder PlanHolder?   @relation(fields: [planHolderId], references: [id], onDelete: SetNull)
  plan       DiscountPlan? @relation(fields: [planId], references: [id])
  userPlan   UserPlan?

  @@index([userId])
  @@index([planHolderId])
  @@index([planId])
  @@index([status])
  @@index([gateway])
  @@index([refId])
  @@index([createdAt])
}

model UserPlan {
  id            String   @id @default(cuid())
  userId        String?
  planId        String
  planHolderId  String
  paymentId     String?  @unique
  referrerId    String? // نماینده‌ای که معرفی کرده
  source        String   @default("ONLINE_PAYMENT") // ONLINE_PAYMENT, SALES_CONFIRMED, ADMIN_GRANT
  status        String   @default("ACTIVE") // ACTIVE, EXPIRED, CANCELLED
  startDate     DateTime @default(now())
  endDate       DateTime
  remainingUses Int      @default(-1) // دفعات باقی‌مانده (-1 = نامحدود)
  totalUses     Int      @default(0)
  paymentRef    String? // reference ID for payment
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user          User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  plan          DiscountPlan   @relation(fields: [planId], references: [id])
  planHolder    PlanHolder     @relation(fields: [planHolderId], references: [id])
  payment       Payment?       @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  referrer      User?          @relation("Referrer", fields: [referrerId], references: [id])
  contracts     Contract[]
  commissions   Commission[]
  visits        Visit[]
  salesCustomer SalesCustomer?

  @@index([userId])
  @@index([planHolderId])
  @@index([status])
  @@index([source])
  @@index([endDate])
}

model SalesCustomer {
  id                 String    @id @default(cuid())
  salesPartnerId     String
  planId             String
  userPlanId         String?   @unique
  firstName          String?
  lastName           String?
  mobile             String?
  nationalCode       String?
  address            String?
  postalCode         String?
  status             String    @default("PENDING_REVIEW") // PENDING_REVIEW, APPROVED, CARD_ISSUED, SHIPPED, DELIVERED, PAID, CONFIRMED, RETURNED
  paymentRef         String?
  paymentDescription String?
  paidAt             DateTime?
  confirmedAt        DateTime?
  returnedAt         DateTime?
  returnReason       String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  salesPartner User         @relation("SalesCustomerSalesPartner", fields: [salesPartnerId], references: [id])
  plan         DiscountPlan @relation(fields: [planId], references: [id])
  userPlan     UserPlan?    @relation(fields: [userPlanId], references: [id], onDelete: SetNull)

  @@index([salesPartnerId])
  @@index([planId])
  @@index([status])
  @@index([nationalCode])
  @@index([paidAt])
  @@index([confirmedAt])
  @@index([returnedAt])
}

// ============================================
// Contracts (قراردادها / ویزیت‌ها)
// ============================================

model Contract {
  id             String    @id @default(cuid())
  userId         String
  userPlanId     String
  doctorId       String
  patientNote    String? // توضیحات بیمار
  doctorNote     String? // گزارش پزشک
  diagnosis      String? // تشخیص
  prescriptions  String? // نسخه (JSON)
  discountAmount Int       @default(0) // مبلغ تخفیف (تومان)
  totalAmount    Int       @default(0) // مبلغ کل (تومان)
  status         String    @default("PENDING") // PENDING, CONFIRMED, COMPLETED, CANCELLED
  confirmedAt    DateTime?
  completedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userPlan UserPlan @relation(fields: [userPlanId], references: [id])
  doctor   Doctor   @relation(fields: [doctorId], references: [id])
  visit    Visit?

  @@index([userId])
  @@index([userPlanId])
  @@index([doctorId])
  @@index([status])
  @@index([createdAt])
}

// ============================================
// Agents (نمایندگان)
// ============================================

model Visit {
  id             String    @id @default(cuid())
  userId         String?
  userPlanId     String
  planHolderId   String
  doctorId       String
  contractId     String?   @unique
  status         String    @default("PENDING") // PENDING, CONFIRMED, COMPLETED, CANCELLED
  patientNote    String?
  doctorNote     String?
  diagnosis      String?
  prescriptions  String?
  discountAmount Int       @default(0)
  totalAmount    Int       @default(0)
  visitedAt      DateTime?
  confirmedAt    DateTime?
  completedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user       User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  userPlan   UserPlan   @relation(fields: [userPlanId], references: [id])
  planHolder PlanHolder @relation(fields: [planHolderId], references: [id])
  doctor     Doctor     @relation(fields: [doctorId], references: [id])
  contract   Contract?  @relation(fields: [contractId], references: [id], onDelete: SetNull)
  review     Review?

  @@index([userId])
  @@index([userPlanId])
  @@index([planHolderId])
  @@index([doctorId])
  @@index([status])
  @@index([createdAt])
}

model Review {
  id        String   @id @default(cuid())
  userId    String
  doctorId  String
  visitId   String   @unique
  rating    Int
  comment   String?
  status    String   @default("PENDING") // PENDING, APPROVED, REJECTED
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  doctor Doctor @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  visit  Visit  @relation(fields: [visitId], references: [id])

  @@index([userId])
  @@index([doctorId])
  @@index([status])
  @@index([createdAt])
}

model Wallet {
  id             String   @id @default(cuid())
  userId         String   @unique
  balance        Int      @default(0)
  pendingBalance Int      @default(0)
  currency       String   @default("IRR")
  status         String   @default("ACTIVE") // ACTIVE, BLOCKED
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions WalletTransaction[]
  settlements  Settlement[]

  @@index([status])
}

model WalletTransaction {
  id            String   @id @default(cuid())
  walletId      String
  userId        String
  type          String // CREDIT, DEBIT, HOLD, RELEASE, SETTLEMENT
  amount        Int      @default(0)
  balanceAfter  Int?
  status        String   @default("SUCCESS") // SUCCESS, PENDING, FAILED, CANCELLED
  description   String?
  referenceType String?
  referenceId   String?
  createdAt     DateTime @default(now())

  wallet Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([walletId])
  @@index([userId])
  @@index([type])
  @@index([status])
  @@index([referenceType, referenceId])
  @@index([createdAt])
}

model Settlement {
  id           String    @id @default(cuid())
  walletId     String
  userId       String
  amount       Int       @default(0)
  status       String    @default("PENDING") // PENDING, APPROVED, PAID, REJECTED, CANCELLED
  trackingCode String?
  receiptUrl   String?
  requestedAt  DateTime  @default(now())
  settledAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  wallet Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([walletId])
  @@index([userId])
  @@index([status])
  @@index([trackingCode])
  @@index([requestedAt])
}

model Agent {
  id           String    @id @default(cuid())
  userId       String    @unique
  businessName String?
  status       String    @default("PENDING") // PENDING, UNDER_REVIEW, APPROVED, REJECTED, SUSPENDED
  score        Float     @default(0)
  description  String?
  verifiedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  documents AgentDocument[]

  @@index([status])
}

model AgentDocument {
  id         String    @id @default(cuid())
  agentId    String
  type       String // NATIONAL_CARD, BUSINESS_LICENSE, CERTIFICATE, OTHER
  file       String // path to file
  status     String    @default("PENDING") // PENDING, APPROVED, REJECTED
  reviewedBy String?
  reviewedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  agent    Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)
  reviewer User? @relation("DocumentReviewer", fields: [reviewedBy], references: [id])

  @@index([agentId])
  @@index([status])
}

// ============================================
// Commissions (پورسانت‌ها)
// ============================================

model Commission {
  id         String    @id @default(cuid())
  agentId    String // کاربر نماینده
  userPlanId String // طرح خریداری شده
  amount     Int       @default(0) // مبلغ پورسانت (تومان)
  percent    Int       @default(0) // درصد پورسانت
  status     String    @default("PENDING") // PENDING, APPROVED, PAID, CANCELLED
  paidAt     DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  agent    User     @relation(fields: [agentId], references: [id])
  userPlan UserPlan @relation(fields: [userPlanId], references: [id])

  @@index([agentId])
  @@index([status])
}

// ============================================
// Transactions (تراکنش‌ها)
// ============================================

model Transaction {
  id          String   @id @default(cuid())
  userId      String
  type        String // PURCHASE, COMMISSION_PAYOUT, REFUND
  amount      Int      @default(0) // مبلغ (تومان)
  description String?
  status      String   @default("SUCCESS") // SUCCESS, FAILED, PENDING
  refId       String? // reference ID
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([type])
  @@index([createdAt])
}

// ============================================
// Page Content (محتوای صفحات عمومی)
// ============================================

model PageContent {
  id        String   @id @default(cuid())
  slug      String   @unique // about, terms, privacy, contact, faq
  title     String
  content   String   @default("")
  status    String   @default("PUBLISHED") // DRAFT, PUBLISHED
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([slug])
}

model AppSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============================================
// Uploads
// ============================================

model Upload {
  id        String   @id @default(cuid())
  userId    String
  path      String
  type      String // AVATAR, DOCUMENT, GENERAL
  size      Int      @default(0)
  mimeType  String   @default("")
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ============================================
// Authentication Tokens & Sessions
// ============================================

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  token     String    @unique
  tokenHash String?
  expiresAt DateTime
  revokedAt DateTime?
  device    String?
  ip        String?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([tokenHash])
  @@index([userId])
}

model UserDevice {
  id          String   @id @default(cuid())
  userId      String
  deviceId    String
  deviceName  String?
  ip          String?
  lastLoginAt DateTime @default(now())
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, deviceId])
}

model LoginLog {
  id        String   @id @default(cuid())
  userId    String?
  mobile    String?
  ip        String?
  device    String?
  status    String // SUCCESS, FAILED
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([createdAt])
}

// ============================================
// OTP Codes (stored in DB for persistence)
// ============================================

model OtpCode {
  id             String   @id @default(cuid())
  mobile         String
  code           String
  verifyAttempts Int      @default(0)
  expiresAt      DateTime
  createdAt      DateTime @default(now())

  @@index([mobile])
  @@index([expiresAt])
}

// ============================================
// Audit Logs
// ============================================

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String // USER_LOGIN, PLAN_PURCHASED, CONTRACT_CREATED, etc.
  entity    String? // User, Agent, Doctor, Plan, Contract, etc.
  entityId  String?
  details   String? // JSON string for additional context
  ip        String?
  device    String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([action])
  @@index([entity])
  @@index([createdAt])
}
